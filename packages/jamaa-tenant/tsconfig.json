{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The parts are typed by src/parts/*.d.ts, never compiled from here (see src/parts/workshop.js).
    "allowJs": false,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
